# ── Required ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_USER_ID=              # your numeric Telegram id (@userinfobot)
ANTHROPIC_API_KEY=

# ── You ─────────────────────────────────────────────────────
OWNER_NAME=                    # how prompts refer to you, default "the owner"
OWNER_PROFILE_FILE=./owner-profile.md
PROJECTS_FILE=./projects.json  # optional, example list is used when unset
TIMEZONE=UTC
PRAYER_CITY=
PRAYER_COUNTRY=
PRAYER_METHOD=4

# ── Models (optional) ───────────────────────────────────────
AI_MODEL=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_ENABLED=0
KIE_API_KEY=
TYPESAFE_API_KEY=              # Jev typed decisions (optional)

# ── Dashboard ───────────────────────────────────────────────
DASHBOARD_PORT=3030
DASHBOARD_USER=
DASHBOARD_PASS=
DASHBOARD_TOKEN=
DASHBOARD_HOSTS=
DASHBOARD_TRUSTED_NETWORKS=

# ── Storage ─────────────────────────────────────────────────
TOKYO_DB_PATH=./life.db
TOKYO_MEDIA_DIR=./whatsapp-media
TOKYO_TRANSCRIPT_DIR=./transcripts

# ── WhatsApp (optional) ─────────────────────────────────────
WA_PROXY=                      # e.g. socks5://localhost:1080
WA_SYNC_FULL_HISTORY=0
WA_TEMPORAL=0
TEMPORAL_ADDRESS=
MYSHOP_GROUP_JIDS=             # comma-separated group JIDs for shop sales logging

# ── Speech-to-text (optional) ───────────────────────────────
TRANSCRIBE_ENABLED=0
TRANSCRIBE_URL=                # self-hosted Whisper endpoint
TRANSCRIBE_TOKEN=
OPENROUTER_STT_MODEL=

# ── Integrations (optional) ─────────────────────────────────
TRELLO_API_KEY=
TRELLO_TOKEN=
GODHOME_URL=
GODHOME_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
