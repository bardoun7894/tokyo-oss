# ── Required ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_USER_ID=              # your numeric Telegram id (@userinfobot)
ANTHROPIC_API_KEY=

# ── You (npm run setup fills these; /setup in Telegram and the dashboard override them) ──
PROFILE_NAME=
PROFILE_COUNTRY=
PROFILE_CITY=
TIMEZONE=UTC                   # IANA name, e.g. Africa/Cairo
PROFILE_LANGUAGE=              # e.g. Egyptian Arabic; empty = answer in the language you write in
CURRENCY=USD                   # e.g. EGP, MAD, EUR
PROFILE_WORK=                  # your job, field or expertise
PROFILE_GOALS=
OWNER_PROFILE_FILE=            # optional markdown with extra notes, see owner-profile.example.md
PROJECTS_FILE=                 # optional, example list is used when unset

# ── Features (1 = on, 0 = off) ──────────────────────────────
FEATURE_PRAYER=1               # prayer times, adhkar, Quran, planning around prayers
FEATURE_SHOP=1                 # shop sales group; inactive until MYSHOP_GROUP_JIDS is set
FEATURE_WHATSAPP=1
PRAYER_CITY=                   # empty = PROFILE_CITY
PRAYER_COUNTRY=                # empty = PROFILE_COUNTRY
PRAYER_METHOD=4

# ── Models (optional) ───────────────────────────────────────
AI_MODEL=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_ENABLED=0
KIE_API_KEY=
TYPESAFE_API_KEY=              # Jev typed decisions (optional)

# ── Dashboard ───────────────────────────────────────────────
DASHBOARD_PORT=3030
DASHBOARD_USER=
DASHBOARD_PASS=
DASHBOARD_TOKEN=
DASHBOARD_HOSTS=
DASHBOARD_TRUSTED_NETWORKS=

# ── Storage ─────────────────────────────────────────────────
TOKYO_DB_PATH=./life.db
TOKYO_MEDIA_DIR=./whatsapp-media
TOKYO_TRANSCRIPT_DIR=./transcripts

# ── WhatsApp (optional) ─────────────────────────────────────
WA_PROXY=                      # e.g. socks5://localhost:1080
WA_SYNC_FULL_HISTORY=0
WA_TEMPORAL=0
TEMPORAL_ADDRESS=
MYSHOP_GROUP_JIDS=             # comma-separated group JIDs for shop sales logging

# ── Speech-to-text (optional) ───────────────────────────────
TRANSCRIBE_ENABLED=0
TRANSCRIBE_URL=                # self-hosted Whisper endpoint
TRANSCRIBE_TOKEN=
OPENROUTER_STT_MODEL=

# ── Integrations (optional) ─────────────────────────────────
TRELLO_API_KEY=
TRELLO_TOKEN=
GODHOME_URL=
GODHOME_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
